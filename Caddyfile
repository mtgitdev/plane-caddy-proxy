# global options
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT} {
	log {
		format json
	}
	
	reverse_proxy /* {$WEB_ENDPOINT} {
		header_up Host plane.karrycar.com
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host plane.karrycar.com
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
	
	handle /god-mode/* {
		reverse_proxy {$ADMIN_ENDPOINT} {
			header_up Host plane.karrycar.com
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host plane.karrycar.com
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
	
	handle /api/* {
		reverse_proxy {$API_ENDPOINT} {
			header_up Host plane.karrycar.com
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host plane.karrycar.com
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
	
	handle /auth/* {
		reverse_proxy {$API_ENDPOINT} {
			header_up Host plane.karrycar.com
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host plane.karrycar.com
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
	
	handle /uploads/* {
		reverse_proxy {$API_ENDPOINT} {
			header_up Host plane.karrycar.com
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host plane.karrycar.com
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
	
	handle /spaces/* {
		reverse_proxy {$SPACES_ENDPOINT} {
			header_up Host plane.karrycar.com
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host plane.karrycar.com
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
	
	handle /{$BUCKET_NAME}/* {
		reverse_proxy {$BUCKET_ENDPOINT} {
			header_up Host plane.karrycar.com
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host plane.karrycar.com
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
}
